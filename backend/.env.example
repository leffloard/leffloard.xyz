# leffloard.xyz backend configuration.
# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Leave an optional value empty to turn that feature off.

# --- Database -----------------------------------------------------------------
# MongoDB connection string. Local MongoDB Community: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
# Database name (created automatically on first write).
DB_NAME=leffloard

# --- Web ----------------------------------------------------------------------
# Public address of the site, without a trailing slash. Used for the admin link in notifications.
SITE_URL=https://leffloard.xyz
# Comma-separated origins allowed to call the API from another domain.
# Leave empty when FastAPI serves the frontend itself (single-server mode) or in development with the Vite proxy.
# Split hosting example: CORS_ORIGINS=https://leffloard.xyz,https://www.leffloard.xyz
CORS_ORIGINS=
# Folder with the built frontend (npm run build). Relative paths are resolved from the backend folder.
# Empty means ../frontend/dist. When the folder is missing, only the API is served.
FRONTEND_DIST=
# Number of proxies in front of the app that add the visitor's address to X-Forwarded-For (see README.md).
# Keep 0 when visitors connect directly, and also behind a proxy or Cloudflare Tunnel on this machine that
# connects to 127.0.0.1: uvicorn already reads the visitor's address from local proxies.
# 1: Cloudflare's proxy (orange cloud) or a proxy on another machine connects to uvicorn directly.
# 2: Cloudflare's proxy in front of nginx or IIS on this machine.
# Never set it higher than the real number of proxies, and with 1 or more let the firewall block connections that
# bypass the proxy; otherwise visitors can dodge the rate limits by sending their own X-Forwarded-For header.
TRUST_PROXY=0

# --- Admin panel (/admin) -----------------------------------------------------
# Both values are required; the admin API answers 503 until they are set.
# Generate them with:  python hash_password.py --secret
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters that signs login tokens. Changing it signs every session out.
ADMIN_JWT_SECRET=

# --- Discord notifications ----------------------------------------------------
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# --- Email notifications ------------------------------------------------------
# SMTP server for new-request emails to you and status emails to clients.
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURITY=starttls
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop   (16-character app password, no spaces)
#   SMTP_FROM=leffloard.xyz <you@gmail.com>
#   NOTIFY_EMAIL_TO=you@gmail.com
# Create the app password at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
SMTP_HOST=
# Usually 587 for starttls, 465 for ssl, 25 for none. Empty means the port matching SMTP_SECURITY.
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address. Empty means SMTP_USERNAME. Gmail only sends from your own address.
SMTP_FROM=
# Your inbox for new-request notifications. Also used as Reply-To on emails to clients.
# Emailing clients from the admin panel only needs the SMTP settings above.
NOTIFY_EMAIL_TO=
