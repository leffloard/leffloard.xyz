# leffloard.xyz v2 configuration.
#
# Development: "npm run dev:db" creates .env.local for you, pointing at a local MongoDB.
#              Development never uses the production database.
# Production:  the same variables go into the server's environment (see docs/ARCHITECTURE.md).
# Only this example is tracked. Never commit a file with real values, and never paste them in chats or issues.
#
# The app checks every value when it starts and prints a plain-English list of anything wrong.

# --- Database -----------------------------------------------------------------
# Local (npm run dev:db):  mongodb://127.0.0.1:27027/?replicaSet=rs0
# MongoDB Atlas:           mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   Paste only the address: no quotes, no <>, no second "MONGO_URL=". If the password contains
#   @ : / ? # or %, URL-encode those characters (@ becomes %40) or use a password of letters and digits.
MONGO_URL=
# Database name. "leffloard" is the database the v1 site already uses.
DB_NAME=leffloard

# --- Web ----------------------------------------------------------------------
# Public address of the site, without a trailing slash.
SITE_URL=http://localhost:3000

# --- Operations ---------------------------------------------------------------
# Secret for the detailed health check (GET /api/health?deep=1 with an x-health-token header), used by
# the deploy script. At least 24 characters. Empty turns the detailed check off.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HEALTH_TOKEN=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
