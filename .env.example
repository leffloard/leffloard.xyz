# leffloard.xyz v2 configuration.
#
# Development: "npm run dev:db" creates .env.local for you, pointing at a local MongoDB.
#              Development never uses the production database.
# Production:  the same variables go into the server's environment (see docs/ARCHITECTURE.md).
# Only this example is tracked. Never commit a file with real values, and never paste them in chats or issues.
#
# The app checks every value when it starts and prints a plain-English list of anything wrong.

# --- Database -----------------------------------------------------------------
# Local (npm run dev:db):  mongodb://127.0.0.1:27027/?replicaSet=rs0
# MongoDB Atlas:           mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   Paste only the address: no quotes, no <>, no second "MONGO_URL=". If the password contains
#   @ : / ? # or %, URL-encode those characters (@ becomes %40) or use a password of letters and digits.
MONGO_URL=
# Database name. "leffloard" is the database the v1 site already uses.
DB_NAME=leffloard

# --- Web ----------------------------------------------------------------------
# Public address of the site, without a trailing slash.
SITE_URL=http://localhost:3000

# --- Secrets stored in the database ------------------------------------------
# Keys that encrypt secrets kept in the database (authenticator secrets, later payment credentials).
# "npm run dev:db" adds a development key to .env.local by itself. Production gets its own key, kept only
# in the server's environment and in the password manager: without it the admin's two-step sign-in cannot
# be read (recover with "npm run admin -- reset-2fa").
# Format: numbered keys, "<number>:<32 random bytes as base64>", comma-separated. New data uses the highest
# number; keep older keys listed until nothing uses them. Generate one:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=

# --- Visitors' addresses (rate limits and the activity log) ---------------------
# socket:     the connecting address (development, or a server nothing else can reach)
# cloudflare: the CF-Connecting-IP header set by Cloudflare. Use this behind the Cloudflare Tunnel.
CLIENT_IP_SOURCE=socket

# --- Cloudflare Turnstile (bot check on sign-in and forms) ----------------------
# Cloudflare dashboard -> Turnstile -> Add widget (hostname leffloard.xyz, mode "Managed").
# Leave both empty to turn the check off (development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare Access in front of /admin (optional, recommended) ----------------
# Zero Trust -> Access -> Applications -> the /admin application:
#   team domain like your-team.cloudflareaccess.com, and the "Application Audience (AUD) Tag".
# With both set, /admin also refuses requests that did not pass through Access.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Notifications and email (the same names as the v1 site's .env) -------------
# New messages from the contact form are announced on Discord and by email; replies and status emails to
# visitors are sent from the inbox. Everything leaves through the outbox, so a failure is retried.
#
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
# The address contains a secret token: keep it only here.
DISCORD_WEBHOOK_URL=
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords) and use
#   SMTP_HOST=smtp.gmail.com  SMTP_SECURITY=starttls  SMTP_USERNAME=<you>@gmail.com  SMTP_PASSWORD=<app password>
SMTP_HOST=
# starttls (port 587, default) | ssl (port 465) | none (port 25, only for a relay on the same machine)
SMTP_SECURITY=starttls
# Leave empty for the usual port of SMTP_SECURITY.
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender, e.g. "Mert Kaan Koparan <you@gmail.com>". Empty uses SMTP_USERNAME.
SMTP_FROM=
# Where alerts about new messages go.
NOTIFY_EMAIL_TO=
# smtp (default) | log: write emails to the server log instead of sending them (development).
EMAIL_DELIVERY=smtp

# --- Crypto payments (NOWPayments, optional) -----------------------------------
# nowpayments.io -> Store Settings: an API key, and the IPN secret key its payment callbacks are signed
# with. Set both, or neither (then invoices offer bank transfer only). Try it first against the sandbox:
#   NOWPAYMENTS_API_URL=https://api-sandbox.nowpayments.io/v1  (with a sandbox account's keys)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# --- Finance --------------------------------------------------------------------
# Exchange rates for the finance reports come from TCMB (the Turkish central bank), twice a day. Only change
# this to go through a mirror; the end-to-end tests point it at a local mock.
TCMB_RATES_URL=https://www.tcmb.gov.tr/kurlar

# --- GitHub (optional) ------------------------------------------------------------
# The work page lists the public repositories you choose (Content -> GitHub), with their stars, from GitHub's
# API. It works without a token (60 requests an hour, plenty for a sync every few hours); a fine-grained
# token with no permissions at all raises the limit. It is only ever sent to GitHub.
GITHUB_TOKEN=

# --- AI assistant (optional) ------------------------------------------------------
# Claude drafts replies, quotes, meeting briefs, weekly reviews and content in the admin; nothing it writes
# is sent or published without you. console.anthropic.com -> API keys: create a key for this server only,
# and set a spend limit there too. The assistant starts switched off: turn it on, pick the model and set
# the monthly budget on the admin's AI page. Without a key it stays off.
ANTHROPIC_API_KEY=

# --- Backups ------------------------------------------------------------------
# Nightly encrypted backups (from 03:15 Istanbul time). Without BACKUP_KEY there are none.
# The key is separate from DATA_ENCRYPTION_KEYS; keep a copy in your password manager: without it no backup
# can be restored. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_KEY=
# A folder outside the app, e.g. C:\leffloard\shared\backups on the server, .data/backups locally.
BACKUP_DIR=
# How many backups to keep (default 14).
BACKUP_KEEP=14

# --- Operations ---------------------------------------------------------------
# on (default) | off: a copy that serves pages but runs no background jobs (the deploy script's trial).
BACKGROUND_JOBS=on
# Secret for the detailed health check (GET /api/health?deep=1 with an x-health-token header), used by
# the deploy script. At least 24 characters. Empty turns the detailed check off.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HEALTH_TOKEN=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
