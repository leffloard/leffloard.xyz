# leffloard.xyz v2 configuration.
#
# Development: "npm run dev:db" creates .env.local for you, pointing at a local MongoDB.
#              Development never uses the production database.
# Production:  the same variables go into the server's environment (see docs/ARCHITECTURE.md).
# Only this example is tracked. Never commit a file with real values, and never paste them in chats or issues.
#
# The app checks every value when it starts and prints a plain-English list of anything wrong.

# --- Database -----------------------------------------------------------------
# Local (npm run dev:db):  mongodb://127.0.0.1:27027/?replicaSet=rs0
# MongoDB Atlas:           mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   Paste only the address: no quotes, no <>, no second "MONGO_URL=". If the password contains
#   @ : / ? # or %, URL-encode those characters (@ becomes %40) or use a password of letters and digits.
MONGO_URL=
# Database name. "leffloard" is the database the v1 site already uses.
DB_NAME=leffloard

# --- Web ----------------------------------------------------------------------
# Public address of the site, without a trailing slash.
SITE_URL=http://localhost:3000

# --- Secrets stored in the database ------------------------------------------
# Keys that encrypt secrets kept in the database (authenticator secrets, later payment credentials).
# "npm run dev:db" adds a development key to .env.local by itself. Production gets its own key, kept only
# in the server's environment and in the password manager: without it the admin's two-step sign-in cannot
# be read (recover with "npm run admin -- reset-2fa").
# Format: numbered keys, "<number>:<32 random bytes as base64>", comma-separated. New data uses the highest
# number; keep older keys listed until nothing uses them. Generate one:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=

# --- Visitors' addresses (rate limits and the activity log) ---------------------
# socket:     the connecting address (development, or a server nothing else can reach)
# cloudflare: the CF-Connecting-IP header set by Cloudflare. Use this behind the Cloudflare Tunnel.
CLIENT_IP_SOURCE=socket

# --- Cloudflare Turnstile (bot check on sign-in and forms) ----------------------
# Cloudflare dashboard -> Turnstile -> Add widget (hostname leffloard.xyz, mode "Managed").
# Leave both empty to turn the check off (development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare Access in front of /admin (optional, recommended) ----------------
# Zero Trust -> Access -> Applications -> the /admin application:
#   team domain like your-team.cloudflareaccess.com, and the "Application Audience (AUD) Tag".
# With both set, /admin also refuses requests that did not pass through Access.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Operations ---------------------------------------------------------------
# Secret for the detailed health check (GET /api/health?deep=1 with an x-health-token header), used by
# the deploy script. At least 24 characters. Empty turns the detailed check off.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HEALTH_TOKEN=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
