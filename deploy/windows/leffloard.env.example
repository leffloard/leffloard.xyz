# leffloard.xyz production settings: C:\leffloard\shared\leffloard.env
# Only the service account and administrators can read this file (install-service.ps1 sets that up).
# Every variable is explained in .env.example in the repository. Keep a copy of the keys marked (!) in your
# password manager: without them the stored secrets and the backups cannot be read.

NODE_ENV=production

# --- Database (MongoDB Atlas) ---
MONGO_URL=
DB_NAME=leffloard

# --- Web ---
SITE_URL=https://leffloard.xyz
# Behind the Cloudflare Tunnel, the visitor's address comes from Cloudflare.
CLIENT_IP_SOURCE=cloudflare
# For the deploy script's checks. At least 24 characters:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HEALTH_TOKEN=

# --- Secrets in the database (!) ---
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=

# --- Cloudflare ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Notifications and email ---
DISCORD_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# --- Backups (!) ---
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_KEY=
BACKUP_DIR=C:\leffloard\shared\backups
BACKUP_KEEP=14

LOG_LEVEL=info
